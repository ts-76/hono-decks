{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "types": ["@cloudflare/workers-types"],
    "jsx": "react-jsx",
    "jsxImportSource": "hono/jsx",
    "skipLibCheck": true,
    "noEmit": true,
    "allowJs": false,
    "verbatimModuleSyntax": true,
    "paths": {
      "hono-decks": ["./src/mod.ts"],
      "hono-decks/*": ["./src/*.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.d.ts", "test/**/*.ts", "worker-configuration.d.ts", "vitest.config.ts", "vitest.dist.config.ts"]
}
