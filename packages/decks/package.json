{
  "name": "hono-decks",
  "version": "0.5.0",
  "description": "Slide decks for Hono and Cloudflare Workers",
  "keywords": [
    "cloudflare-workers",
    "hono",
    "mdx",
    "slides",
    "tanstack-intent"
  ],
  "homepage": "https://github.com/ts-76/hono-decks#readme",
  "bugs": {
    "url": "https://github.com/ts-76/hono-decks/issues"
  },
  "license": "MIT",
  "author": "ts-76",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ts-76/hono-decks.git",
    "directory": "packages/decks"
  },
  "bin": {
    "hono-decks": "bin/hono-decks.js"
  },
  "files": [
    "bin",
    "dist",
    "README.md",
    "README.ja.md",
    "skills",
    "vite-env.d.ts"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "import": "./dist/mod.js"
    },
    "./advanced": {
      "types": "./dist/advanced.d.ts",
      "import": "./dist/advanced.js"
    },
    "./cli": {
      "types": "./dist/cli.d.ts",
      "import": "./dist/cli.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./remote": {
      "types": "./dist/remote.d.ts",
      "import": "./dist/remote.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./honox": {
      "types": "./dist/honox.d.ts",
      "import": "./dist/honox.js"
    },
    "./vite-env": {
      "types": "./vite-env.d.ts"
    },
    "./adapters/hono-markdown": {
      "types": "./dist/adapters/hono-markdown.d.ts",
      "import": "./dist/adapters/hono-markdown.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
    "test": "vp test run",
    "test:dist": "bun run build && vp test run --config vitest.dist.config.ts",
    "skills:validate": "intent validate skills",
    "skills:stale": "intent stale .",
    "check": "bun run typecheck && bun run test && bun run test:dist && bun run skills:validate"
  },
  "dependencies": {
    "@babel/parser": "^8.1.0",
    "@mdx-js/mdx": "^3.1.1",
    "esbuild": "^0.28.2",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.0",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "shiki": "^4.6.0",
    "unified": "^11.0.5",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@tanstack/intent": "^0.5.5",
    "hono": "^4.13.16",
    "honox": "0.1.62",
    "vite": "catalog:",
    "vite-plus": "catalog:"
  },
  "peerDependencies": {
    "hono": "^4.13.16",
    "vite": "^6.0.0 || ^7.0.0 || ^8.0.0"
  },
  "peerDependenciesMeta": {
    "vite": {
      "optional": true
    }
  }
}
