{
  "name": "hono-decks-monorepo",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/basic",
    "examples/minimal",
    "examples/honox",
    "examples/ogp",
    "docs"
  ],
  "type": "module",
  "scripts": {
    "build": "bun run --cwd packages/decks build",
    "generate": "bun run --filter '@hono-decks/example-*' decks:compile",
    "dev": "bun run --cwd examples/basic dev",
    "dev:minimal": "bun run --cwd examples/minimal dev",
    "dev:honox": "bun run --cwd examples/honox dev",
    "dev:ogp": "bun run --cwd examples/ogp dev",
    "build:ogp": "bun run --cwd examples/ogp build",
    "deploy:minimal": "bun run --cwd examples/minimal deploy:production",
    "deploy:basic": "bun run --cwd examples/basic deploy:production",
    "deploy:honox": "bun run --cwd examples/honox deploy:production",
    "deploy:ogp": "bun run --cwd examples/ogp deploy:production",
    "smoke:package": "bun run build && node scripts/smoke-package.mjs",
    "smoke:package:compat": "bun run build && node scripts/smoke-package-matrix.mjs",
    "smoke:browser-run": "bun run --cwd examples/basic smoke:browser-run",
    "smoke:pdf": "bun run --cwd examples/basic smoke:pdf",
    "smoke:viewport": "bun run --cwd examples/basic smoke:viewport",
    "release": "node scripts/verify-release-baseline.mjs && semantic-release",
    "format": "vp fmt",
    "lint": "vp lint",
    "typecheck": "bun run --filter hono-decks --filter '@hono-decks/*' typecheck",
    "test": "bun run --filter hono-decks --filter '@hono-decks/*' test",
    "check": "bun run build && bun run generate && vp check && bun run typecheck && bun run test && bun run --cwd packages/decks test:dist && bun run build:ogp && bun run build:docs && node --test scripts/release-notes.test.mjs",
    "dev:docs": "bun run --cwd docs dev",
    "build:docs": "bun run --cwd docs build",
    "deploy:docs": "bun run --cwd docs deploy"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^26.6.6",
    "conventional-changelog-conventionalcommits": "9.3.1",
    "semantic-release": "^25.0.9",
    "semver": "^7.8.5",
    "tsdown": "^0.23.4",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.156.2"
  },
  "overrides": {
    "handlebars": "4.7.10",
    "hono": "4.13.16",
    "vite": "catalog:"
  },
  "packageManager": "bun@1.3.13",
  "catalog": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  }
}
