{
  "name": "@hono-decks/example-minimal",
  "private": true,
  "type": "module",
  "scripts": {
    "decks:compile": "hono-decks compile",
    "dev": "wrangler dev --live-reload",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "deploy:production": "wrangler deploy --config wrangler.production.jsonc",
    "typecheck": "bun run decks:compile && tsc --noEmit",
    "test": "bun run decks:compile && vp test run",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "hono": "^4.13.12",
    "hono-decks": "0.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261001.1",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@0.2.4",
    "vite-plus": "0.2.4",
    "vitest": "4.1.10",
    "wrangler": "^4.146.0"
  },
  "packageManager": "bun@1.3.13"
}
