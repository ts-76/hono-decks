{
  "name": "@hono-decks/example-ogp",
  "private": true,
  "type": "module",
  "imports": {
    "#decks": "./.hono-decks/decks.ts"
  },
  "scripts": {
    "decks:compile": "bun scripts/compile.ts",
    "decks:compile:hook": "bun scripts/compile.ts",
    "dev": "cf dev",
    "build": "cf build",
    "deploy": "cf deploy",
    "deploy:production": "cf deploy --mode production",
    "typecheck": "bun run decks:compile && tsc --noEmit",
    "test": "bun run decks:compile && vp test run",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "hono-decks": "0.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@resvg/resvg-js": "^2.6.2",
    "@types/node": "^26.6.4",
    "cf": "1.0.0-beta.28",
    "satori": "^0.63.2",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.5.0",
    "wrangler": "^4.158.0"
  },
  "packageManager": "bun@1.3.13",
  "hono-decks": {
    "configFile": "decks/config.ts"
  }
}
