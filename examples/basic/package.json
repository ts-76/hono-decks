{
  "name": "@hono-decks/example-basic",
  "private": true,
  "type": "module",
  "imports": {
    "#decks": "./.hono-decks/decks.ts"
  },
  "scripts": {
    "decks:compile": "hono-decks compile",
    "decks:compile:hook": "hono-decks compile",
    "dev": "cf dev",
    "deploy": "cf deploy",
    "deploy:production": "cf deploy --mode production",
    "smoke:browser-run": "node scripts/browser-run-smoke.mjs",
    "smoke:pdf": "node scripts/pdf-smoke.mjs",
    "smoke:r2-cache": "node scripts/deployed-r2-cache-smoke.mjs",
    "smoke:viewport": "node scripts/viewport-smoke.mjs",
    "typecheck": "bun run decks:compile && tsc --noEmit",
    "test": "bun run decks:compile && vp test run",
    "check": "bun run typecheck && bun run test",
    "build": "cf build"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "hono-decks": "0.5.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/node": "^26.6.4",
    "cf": "1.0.0-beta.28",
    "pdf-lib": "1.17.1",
    "typescript": "^7.0.2",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "wrangler": "^4.158.0"
  },
  "packageManager": "bun@1.3.13",
  "hono-decks": {
    "configFile": "decks/config.ts"
  }
}
