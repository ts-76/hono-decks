{
  "name": "@hono-decks/docs",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --cwd ../packages/decks build -- --clean=false && vp dev",
    "build": "bun run --cwd ../packages/decks build && vp build --mode client && vp build",
    "deploy": "bun run build && wrangler deploy",
    "preview": "wrangler dev",
    "typecheck": "tsc --noEmit",
    "test": "vp test run",
    "check": "bun run typecheck && bun run test && bun run build"
  },
  "dependencies": {
    "hono": "^4.13.16",
    "hono-decks": "workspace:*",
    "honox": "0.1.62",
    "honoxpress": "0.4.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261102.1",
    "@hono/vite-build": "^1.11.1",
    "@hono/vite-dev-server": "^0.26.1",
    "@mdx-js/rollup": "3.1.1",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-mdx-frontmatter": "6.0.0",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "wrangler": "^4.156.2"
  }
}
